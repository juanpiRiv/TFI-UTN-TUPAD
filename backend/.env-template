# Copiar como backend/.env y completar. Nunca commitear el .env (RN-14).

# Postgres del docker-compose.yml (puerto 5433 en la maquina local)
DATABASE_URL=postgresql://tfi:tfi@localhost:5433/tfi_finanzas

# Minimo 32 caracteres. Se puede generar con: openssl rand -hex 32
JWT_SECRET=

PORT=3000

# Orígenes permitidos para CORS separados por coma (produccion).
# Vacio = abierto, solo para desarrollo local.
# CORS_ORIGIN=https://tfi-tupad.pages.dev

# --- ARCA (facturación electrónica) ---
# ARCA_PROVIDER y ARCA_MODE las lee el backend (ARCA_PROVIDER es obligatoria al
# arrancar el servidor). ARCA_ENCRYPTION_KEY todavía no se lee.
# Nunca commitear certificados ni claves.

# Ambiente de ARCA al que se conecta: homologacion (por defecto) o produccion.
# Los certificados de WSASS (homologación) no sirven en producción.
# ARCA_MODE=homologacion

# Proveedor fiscal. Obligatoria: sin ella el servidor no arranca.
#   simulated  cliente simulado, para desarrollo y demo (sin validez fiscal)
#   sdk        cliente sobre la librería facturas
#   direct     cliente propio (todavía no disponible, PR #141)
ARCA_PROVIDER=simulated

# Credenciales de prueba para ARCA_PROVIDER=sdk (sirve para probar contra homologación
# con un certificado propio). El certificado y la clave son archivos PEM que NO van en el
# repositorio: guardalos fuera del proyecto. Se pueden dar como rutas o como texto PEM.
# ARCA_CUIT=
# ARCA_CERT_PATH=
# ARCA_KEY_PATH=
# ARCA_CERT_PEM=
# ARCA_KEY_PEM=

# Carpeta donde el backend y los scripts comparten el ticket de acceso de ARCA (dura 12 horas).
# ARCA no entrega otro ticket mientras el anterior sigue vigente. Por defecto: ~/.arca-homologacion/sessions
# ARCA_SESSION_DIR=

# Con el proveedor sdk, ARCA_MODE=produccion queda bloqueado: emite comprobantes con validez
# fiscal. Solo se habilita escribiendo exactamente true. Para homologación no se necesita.
# ARCA_ALLOW_PRODUCTION=

# Clave para cifrar en la base el certificado y la clave privada de cada
# organización. Se puede generar con: openssl rand -hex 32
# ARCA_ENCRYPTION_KEY=
