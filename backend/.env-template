# Copiar como backend/.env y completar. Nunca commitear el .env (RN-14).

# Postgres del docker-compose.yml (puerto 5433 en la maquina local)
DATABASE_URL=postgresql://tfi:tfi@localhost:5433/tfi_finanzas

# Minimo 32 caracteres. Se puede generar con: openssl rand -hex 32
JWT_SECRET=

PORT=3000

# Orígenes permitidos para CORS separados por coma (produccion).
# Vacio = abierto, solo para desarrollo local.
# CORS_ORIGIN=https://tfi-utn-tupad.pages.dev

# --- ARCA (facturación electrónica) ---
# Solo documentación: el backend todavía no lee estas variables. La fábrica de
# proveedores está pendiente (#134). Nunca commitear certificados ni claves.

# Ambiente de ARCA al que se conecta: homologacion o produccion.
# Los certificados de WSASS (homologación) no sirven en producción.
# ARCA_MODE=homologacion

# Proveedor fiscal: el cliente simulado para desarrollo y demo, o uno real.
# ARCA_PROVIDER=

# Clave para cifrar en la base el certificado y la clave privada de cada
# organización. Se puede generar con: openssl rand -hex 32
# ARCA_ENCRYPTION_KEY=
