// Esquema inicial de la base de datos.
// Tiene que coincidir con docs/03-modelo-de-datos.md.
// Las restricciones CHECK que Prisma no soporta van en una migración SQL aparte
// (ver docs/02-atomicidad-concurrencia.md, sección 7).

// Pensado para Prisma 7: las URLs de conexión (DATABASE_URL y la conexión
// directa para migraciones) van en backend/prisma.config.ts, no acá.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  ARS
  USD
}

enum VatCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}

enum DocType {
  CUIT
  CUIL
  DNI
  FINAL
}

enum ActivityKind {
  GOODS
  SERVICES
}

enum BillingMethod {
  WEB_SERVICE
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RateSource {
  BCRA
  MANUAL
}

enum InvoiceConcept {
  PRODUCTS
  SERVICES
  BOTH
}

enum FiscalStatus {
  DRAFT
  PENDING_AUTHORIZATION
  AUTHORIZED
  REJECTED
}

enum CommercialStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  MERCADO_PAGO
  OTHER
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  name         String        @db.VarChar(120)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  organization Organization?
  auditLogs    AuditLog[]

  @@map("users")
}

model Organization {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @unique @map("user_id") @db.Uuid
  cuit                String       @db.Char(11)
  businessName        String       @map("business_name") @db.VarChar(200)
  vatCondition        VatCondition @default(MONOTRIBUTO) @map("vat_condition")
  monotributoCategory String?      @map("monotributo_category") @db.VarChar(2)
  activityStartDate   DateTime     @map("activity_start_date") @db.Date
  taxAddress          String       @map("tax_address") @db.VarChar(255)
  baseCurrency        Currency     @default(ARS) @map("base_currency")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  activities        Activity[]
  pointsOfSale      PointOfSale[]
  clients           Client[]
  categories        Category[]
  transactions      Transaction[]
  invoices          Invoice[]
  arcaAccessTickets ArcaAccessTicket[]
  auditLogs         AuditLog[]
  idempotencyKeys   IdempotencyKey[]

  @@map("organizations")
}

model Activity {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  afipActivityCode String       @map("afip_activity_code") @db.VarChar(6)
  description      String       @db.VarChar(255)
  activityKind     ActivityKind @map("activity_kind")
  isPrimary        Boolean      @default(false) @map("is_primary")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("activities")
}

model PointOfSale {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  number         Int
  billingMethod  BillingMethod @default(WEB_SERVICE) @map("billing_method")
  address        String?       @db.VarChar(255)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@unique([organizationId, number])
  @@map("points_of_sale")
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  docType        DocType      @map("doc_type")
  docNumber      String?      @map("doc_number") @db.VarChar(11)
  name           String       @db.VarChar(200)
  vatCondition   VatCondition @map("vat_condition")
  email          String?      @db.VarChar(255)
  phone          String?      @db.VarChar(40)
  address        String?      @db.VarChar(255)
  isActive       Boolean      @default(true) @map("is_active")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoices     Invoice[]
  transactions Transaction[]

  @@unique([organizationId, docType, docNumber])
  @@index([organizationId, name])
  @@map("clients")
}

model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(80)
  type           CategoryType
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([organizationId, name, type])
  @@map("categories")
}

model ExchangeRate {
  id        String     @id @default(uuid()) @db.Uuid
  currency  Currency
  rateDate  DateTime   @map("rate_date") @db.Date
  rate      Decimal    @db.Decimal(18, 6)
  source    RateSource
  fetchedAt DateTime   @default(now()) @map("fetched_at")

  @@unique([currency, rateDate, source])
  @@map("exchange_rates")
}

model Invoice {
  id                       String            @id @default(uuid()) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  pointOfSaleId            String            @map("point_of_sale_id") @db.Uuid
  clientId                 String?           @map("client_id") @db.Uuid
  voucherType              Int               @default(11) @map("voucher_type") @db.SmallInt
  voucherNumber            Int?              @map("voucher_number")
  concept                  InvoiceConcept
  issueDate                DateTime          @map("issue_date") @db.Date
  serviceFrom              DateTime?         @map("service_from") @db.Date
  serviceTo                DateTime?         @map("service_to") @db.Date
  paymentDueDate           DateTime?         @map("payment_due_date") @db.Date
  recipientDocType         DocType           @map("recipient_doc_type")
  recipientDocNumber       String?           @map("recipient_doc_number") @db.VarChar(11)
  recipientName            String            @map("recipient_name") @db.VarChar(200)
  recipientVatCondition    VatCondition      @map("recipient_vat_condition")
  currency                 Currency          @default(ARS)
  exchangeRate             Decimal           @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  totalAmount              Decimal           @map("total_amount") @db.Decimal(14, 2)
  fiscalStatus             FiscalStatus      @default(DRAFT) @map("fiscal_status")
  commercialStatus         CommercialStatus? @map("commercial_status")
  cae                      String?           @db.VarChar(14)
  caeExpiration            DateTime?         @map("cae_expiration") @db.Date
  authorizationRequestedAt DateTime?         @map("authorization_requested_at")
  arcaObservations         String?           @map("arca_observations")
  version                  Int               @default(1)
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pointOfSale  PointOfSale   @relation(fields: [pointOfSaleId], references: [id], onDelete: Restrict)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]
  payments     Payment[]

  // Postgres permite varios NULL en un índice único, así que los borradores
  // sin número no chocan entre sí.
  @@unique([organizationId, pointOfSaleId, voucherType, voucherNumber])
  @@index([organizationId, issueDate])
  @@index([fiscalStatus, authorizationRequestedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String  @db.VarChar(255)
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  subtotal    Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  currency      Currency      @default(ARS)
  exchangeRate  Decimal       @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  paymentMethod PaymentMethod @map("payment_method")
  paymentDate   DateTime      @map("payment_date") @db.Date
  voidedAt      DateTime?     @map("voided_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  transaction Transaction?

  @@index([invoiceId])
  @@map("payments")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  clientId        String?         @map("client_id") @db.Uuid
  paymentId       String?         @unique @map("payment_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  currency        Currency
  exchangeRate    Decimal         @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  amountBase      Decimal         @map("amount_base") @db.Decimal(14, 2)
  description     String?         @db.VarChar(255)
  transactionDate DateTime        @map("transaction_date") @db.Date
  voidedAt        DateTime?       @map("voided_at")
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([organizationId, transactionDate])
  @@index([organizationId, categoryId])
  @@map("transactions")
}

model ArcaAccessTicket {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  service        String   @db.VarChar(20)
  token          String
  sign           String
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, service])
  @@map("arca_access_tickets")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(50)
  entity         String?  @db.VarChar(50)
  entityId       String?  @map("entity_id") @db.Uuid
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(64)
  endpoint       String   @db.VarChar(100)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, key])
  @@map("idempotency_keys")
}
